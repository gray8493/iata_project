@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Lớp Toàn Diện 3 Phân Hệ (System-Wide Class Diagram - 3 Subsystems)\nHệ Sinh Thái AITA (Tích hợp Factory Method, Adapter Pattern & Strategy Pattern)

' ==============================================================================
' PHÂN HỆ 1: SANDBOX EXECUTION & COMPILER ENGINE (LOCAL DESKTOP ENGINE)
' Mẫu thiết kế áp dụng:
'   - Creational Pattern: Factory Method (RunnerFactory -> BaseRunner)
'   - Structural Pattern: Adapter Pattern (CompilerAdapter -> GccCompilerAdapter, JavacCompilerAdapter, PythonInterpreterAdapter)
' ==============================================================================
package "Phân Hệ 1: Sandbox Execution & Compiler Engine (Local Engine)" #E8F5E9 {

    abstract class BaseRunner {
        + {abstract} compile(source_path: Path): Tuple[bool, str, Optional[str]]
        + {abstract} execute(executable_target: str, input_data: str, time_limit_ms: int, memory_limit_mb: int): SandboxResult
    }

    class CRunner {
        - adapter: GccCompilerAdapter
        + compile(source_path: Path): Tuple[bool, str, Optional[str]]
        + execute(executable_target: str, input_data: str, time_limit_ms: int, memory_limit_mb: int): SandboxResult
    }

    class JavaRunner {
        - adapter: JavacCompilerAdapter
        + compile(source_path: Path): Tuple[bool, str, Optional[str]]
        + execute(executable_target: str, input_data: str, time_limit_ms: int, memory_limit_mb: int): SandboxResult
    }

    class PythonRunner {
        - adapter: PythonInterpreterAdapter
        + compile(source_path: Path): Tuple[bool, str, Optional[str]]
        + execute(executable_target: str, input_data: str, time_limit_ms: int, memory_limit_mb: int): SandboxResult
    }

    class WebRubricEngine {
        - ai_service: AiService
        - screenshots_dir: Path
        + grade(submission: Dict, mode: str): WebRubricResult
        + _fetch_github_raw(repo_url: Optional[str]): Tuple[str, List[str]]
    }

    class RunnerFactory <<Creational - Factory Method>> {
        - {static} _REGISTRY: Dict[str, Type[BaseRunner]]
        + {static} register_runner(language_key: str, runner_cls: Type): void
        + {static} get_runner(language: str): BaseRunner
    }

    interface CompilerAdapter <<Structural - Adapter>> {
        + compile(source_path: Path): CompileResult
    }

    class GccCompilerAdapter {
        - timeout: float = 12.0
        + compile(source_path: Path): CompileResult
        - _run(cmd: List[str]): CompileResult
    }

    class JavacCompilerAdapter {
        - timeout: float = 12.0
        + compile(source_path: Path): CompileResult
    }

    class PythonInterpreterAdapter {
        + compile(source_path: Path): CompileResult
    }

    class CompilerAdapterFactory {
        + {static} ADAPTERS: Dict[str, Type[CompilerAdapter]]
        + {static} get_adapter(language: str, timeout: float = 12.0): CompilerAdapter
    }

    class SandboxRunner <<Sandbox>> {
        + {static} run_process(command: List[str], input_data: str, time_limit_ms: int, memory_limit_mb: int, cwd: Optional[str]): SandboxResult
    }

    class CompileResult <<dataclass>> {
        + success: bool
        + log: str
        + target: Optional[str]
        + compiler: str
        + timed_out: bool
        + {get} verdict: str
    }

    class SandboxResult <<dataclass>> {
        + stdout: str
        + stderr: str
        + return_code: int
        + execution_time_ms: float
        + memory_used_mb: float
        + verdict: str
        + error_message: Optional[str]
    }

    BaseRunner <|-- CRunner
    BaseRunner <|-- JavaRunner
    BaseRunner <|-- PythonRunner

    RunnerFactory ..> BaseRunner : <<creates>>
    RunnerFactory ..> CRunner : <<instantiates>>
    RunnerFactory ..> JavaRunner : <<instantiates>>
    RunnerFactory ..> PythonRunner : <<instantiates>>

    CompilerAdapter <|.. GccCompilerAdapter
    CompilerAdapter <|.. JavacCompilerAdapter
    CompilerAdapter <|.. PythonInterpreterAdapter
    CompilerAdapterFactory ..> CompilerAdapter : resolves

    CRunner o-- GccCompilerAdapter
    JavaRunner o-- JavacCompilerAdapter
    PythonRunner o-- PythonInterpreterAdapter
    BaseRunner --> SandboxRunner : uses (psutil: bắt TLE/MLE/RE)
    BaseRunner ..> CompileResult : produces
    BaseRunner ..> SandboxResult : produces
    WebRubricEngine ..> WebRubricResult : generates
}

' ==============================================================================
' PHÂN HỆ 2: GRADING CORE & OUTPUT MATCHING SUBSYSTEM (DESKTOP BUSINESS LAYER)
' Mẫu thiết kế áp dụng:
'   - Behavioral Pattern: Strategy Pattern (MatchingStrategy & 7 Concrete Strategies + Flexible)
' ==============================================================================
package "Phân Hệ 2: Grading Core & Output Matching Subsystem" #EDE7F6 {

    class MatchResult <<dataclass>> {
        + is_matched: bool
        + verdict: str
        + score_ratio: float
        + diff_details: Optional[str]
        + message: Optional[str]
    }

    interface IMatchingStrategy <<Behavioral - Strategy>> {
        + {abstract} compare(actual: str, expected: str): MatchResult
    }

    class ExactMatchStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class IgnoreWhitespaceStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class CaseInsensitiveStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class FloatingPointToleranceStrategy {
        - tolerance_epsilon: float
        + compare(actual: str, expected: str): MatchResult
    }

    class UnorderedTokensStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class RegexPatternStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class SpecialJudgeStrategy {
        - checker_script_path: Path
        + compare(actual: str, expected: str): MatchResult
    }

    class FlexibleMatchingStrategy {
        - ignore_whitespace: bool
        - case_insensitive: bool
        - floating_tolerance: bool
        - unordered_tokens: bool
        - regex_pattern: bool
        - special_judge: bool
        + compare(actual: str, expected: str): MatchResult
    }

    class MatchingContext {
        - _strategy: IMatchingStrategy
        + STRATEGY_REGISTRY: Dict[str, Type[IMatchingStrategy]]
        + set_strategy(strategy: IMatchingStrategy): void
        + set_strategy_by_name(strategy_name: str, **kwargs): void
        + compare(actual: str, expected: str): MatchResult
    }

    class GradingService {
        - db_manager: DatabaseManager
        - matching_context: MatchingContext
        + grade_class_batch(class_id: int, settings: Dict): Dict
        + regrade_submission(submission_id: int, enable_ai_quality: bool): Dict
        - _save_result(res: Dict): void
        - _enrich_with_ai_quality(res: Dict): Dict
    }

    class BatchGradingWorker <<QThread>> {
        + run(): void
        + cancel(): void
    }

    class Submission {
        + id: int
        + class_id: int
        + student_mssv: str
        + source_file_path: str
        + status: str
    }

    class TestCase {
        + id: int
        + class_id: int
        + question_number: str
        + input_data: str
        + expected_output: str
        + score_weight: float
        + time_limit_ms: int
        + memory_limit_mb: int
        + matching_strategy: str
        + is_hidden: int
    }

    class GradingResult {
        + id: int
        + submission_id: int
        + matching_strategy: str
        + calculated_score: float
        + final_verdict: str
        + execution_time_ms: float
        + memory_used_mb: float
        + compile_log: str
        + diff_details: str
        + ai_feedback: str
        + manual_override_score: float
        + manual_override_reason: str
        + graded_at: datetime
    }

    class WebRubricResult <<dataclass>> {
        + score_dom: Optional[float]
        + score_lint: Optional[float]
        + score_func: Optional[float]
        + score_ui: Optional[float]
        + total_score: float
        + verdict: str
        + screenshot_path: Optional[str]
        + rubric_log: str
        + ai_feedback: str
        + error: Optional[str]
    }

    IMatchingStrategy <|.. ExactMatchStrategy
    IMatchingStrategy <|.. IgnoreWhitespaceStrategy
    IMatchingStrategy <|.. CaseInsensitiveStrategy
    IMatchingStrategy <|.. FloatingPointToleranceStrategy
    IMatchingStrategy <|.. UnorderedTokensStrategy
    IMatchingStrategy <|.. RegexPatternStrategy
    IMatchingStrategy <|.. SpecialJudgeStrategy
    IMatchingStrategy <|.. FlexibleMatchingStrategy
    IMatchingStrategy ..> MatchResult : returns

    MatchingContext o-- IMatchingStrategy
    GradingService *-- MatchingContext
    GradingService --> RunnerFactory : requests runner
    BatchGradingWorker ..> GradingService : dispatches (ProcessPoolExecutor)
    GradingService o-- Submission
    GradingService o-- TestCase
    GradingService ..> GradingResult : generates
    GradingService ..> WebRubricResult : generates (Web mode)
}

' ==============================================================================
' PHÂN HỆ 3: CENTRAL BACKEND & AI GATEWAY SUBSYSTEM (NESTJS SERVICE)
' Mẫu thiết kế & Kiến trúc:
'   - Facade / Service Layer Pattern
'   - Role-Based Access Control (RBAC) & OAuth2 JWT
' ==============================================================================
package "Phân Hệ 3: Central Backend & AI Gateway Subsystem (NestJS Service)" #E3F2FD {

    class AuthController {
        - auth_service: AuthService
        + login(dto: LoginDto): TokenResponse
        + me(user: AuthUser): UserProfile
        + refresh(dto: RefreshTokenDto): TokenResponse
    }

    class AIGatewayController {
        - ai_service: AiGatewayService
        - openrouter: OpenRouterService
        + generateTestcases(user: AuthUser, dto: GenerateTestcasesDto)
        + reviewCode(user: AuthUser, dto: ReviewCodeDto)
        + verifyPlagiarism(user: AuthUser, dto: VerifyPlagiarismDto)
        + evaluateWebUi(user: AuthUser, dto: EvaluateWebUiDto)
        + evaluatePeCode(user: AuthUser, dto: EvaluatePeCodeDto)
        + getProviderStatus(): ProviderStatus
    }

    class AuthService {
        + login(input: LoginDto): TokenPair
        + refresh(rawToken: string): TokenPair
        + me(userId: string): UserProfile
    }

    class AiQuotaService {
        + snapshot(userId: string): QuotaSnapshot
        + reserve(userId: string, amount: int): QuotaReservation
        + settle(userId: string, reservation: QuotaReservation, usage: TokenUsage, feature: AiFeature, model: string): void
        + release(reservation: QuotaReservation): void
    }

    class AiGatewayService <<Service Layer / AI Gateway>> {
        + generateTestcases(userId: string, input: GenerateTestcasesDto)
        + reviewCode(userId: string, input: ReviewCodeDto)
        + verifyPlagiarism(userId: string, input: VerifyPlagiarismDto)
        + evaluateWebUi(userId: string, input: EvaluateWebUiDto)
        + evaluatePeCode(userId: string, input: EvaluatePeCodeDto)
    }

    class OpenRouterService <<AI Provider (multi-key)>> {
        - apiKeys: string[]
        - baseUrl: string
        - model: string
        - models: string[]
        + chat(payload: ChatRequest): ChatCompletionResponse
        + providerStatus(): ProviderStatus
    }

    class User <<Entity>> {
        + id: uuid
        + username: string
        + password_hash: string
        + full_name: string
        + email: string
        + role: ADMIN | INSTRUCTOR
        + is_active: bool
        + is_deleted: bool
    }

    class AiQuotaConfig <<Entity>> {
        + id: uuid
        + user_id: uuid
        + daily_token_limit: int
        + used_tokens_today: int
        + last_reset_date: date
    }

    class AiQuotaLog <<Entity>> {
        + id: uuid
        + user_id: uuid
        + feature_type: TESTCASE_GEN | CODE_REVIEW | PLAGIARISM | UI_EVALUATION | PE_CODE_EVAL
        + model_name: string
        + prompt_tokens: int
        + completion_tokens: int
        + total_tokens: int
        + created_at: datetime
    }

    AuthController --> AuthService
    AIGatewayController --> AiGatewayService
    AIGatewayController --> OpenRouterService
    AiGatewayService --> AiQuotaService : reserve / settle
    AiGatewayService --> OpenRouterService : calls (fetch, xoay vòng key)

    AuthService ..> User : manages
    AiQuotaService ..> AiQuotaConfig : resets daily (UTC)
    AiQuotaService ..> AiQuotaLog : persists
}

' ==============================================================================
' LIÊN KẾT GIAO TIẾP GIỮA CÁC PHÂN HỆ (CROSS-SUBSYSTEM RELATIONSHIPS)
' ==============================================================================

' Desktop Batch Grading kết nối với Sandbox Engine
GradingService --> BaseRunner : executes code (offline)

' Desktop App kết nối mạng với Backend API qua RESTful Calls (Auth + AI Gateway)
AiService ..> AIGatewayController : HTTP POST /ai/* & GET /ai/quota (httpx)

' Ghi chú làm nổi bật 3 Mẫu thiết kế bắt buộc theo Rubric SWD392
note top of RunnerFactory
  <b>1. Creational Pattern: Factory Method</b>
  Tự động nhận diện đuôi file (.c, .java, .py)
  để sản xuất đối tượng Runner tương ứng.
end note

note top of CompilerAdapter
  <b>2. Structural Pattern: Adapter Pattern</b>
  Đồng nhất hóa giao diện biên dịch và chuẩn hóa
  mã lỗi stderr giữa GCC, Javac và Python (py_compile).
end note

note top of IMatchingStrategy
  <b>3. Behavioral Pattern: Strategy Pattern</b>
  Cung cấp 7 chiến lược so khớp đầu ra linh hoạt
  kết hợp đa cờ qua FlexibleMatchingStrategy lúc runtime.
end note

@enduml
