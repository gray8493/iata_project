@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Lớp Toàn Diện 3 Phân Hệ (System-Wide Class Diagram - 3 Subsystems)\nHệ Sinh Thái AITA (Tích hợp Factory Method, Adapter Pattern & Strategy Pattern)

' ==============================================================================
' PHÂN HỆ 1: SANDBOX EXECUTION & COMPILER ENGINE (LOCAL DESKTOP ENGINE)
' Mẫu thiết kế áp dụng:
'   - Creational Pattern: Factory Method (RunnerFactory -> BaseRunner)
'   - Structural Pattern: Adapter Pattern (CompilerAdapter -> GccAdapter, JavacAdapter)
' ==============================================================================
package "Phân Hệ 1: Sandbox Execution & Compiler Engine (Local Engine)" #E8F5E9 {

    abstract class BaseRunner {
        # source_path: Path
        # executable_path: Path
        # time_limit_ms: int
        # memory_limit_mb: int
        + {abstract} compile(): CompileResult
        + {abstract} execute_main(stdin_input: str): ExecutionResult
        # monitor_resources(process_pid: int): ResourceUsage
    }

    class CRunner {
        - compiler_adapter: CompilerAdapter
        + compile(): CompileResult
        + execute_main(stdin_input: str): ExecutionResult
    }

    class JavaRunner {
        - compiler_adapter: CompilerAdapter
        + compile(): CompileResult
        + execute_main(stdin_input: str): ExecutionResult
    }

    class PythonRunner {
        + compile(): CompileResult
        + execute_main(stdin_input: str): ExecutionResult
    }

    class WebRunner {
        - playwright_browser: Any
        - rubric_weights: Dict[str, float]
        + compile(): CompileResult
        + execute_main(stdin_input: str): ExecutionResult
        + evaluate_dom_structure(html_path: Path): float
        + run_w3c_lint(html_path: Path): float
        + run_playwright_e2e(test_script: str): float
        + evaluate_ui_gemini_vision(screenshot_path: Path): float
        + calculate_composite_score(): float
    }

    class RunnerFactory <<Creational - Factory Method>> {
        + {static} create_runner(file_extension: str, source_path: Path): BaseRunner
    }

    interface CompilerAdapter <<Structural - Adapter>> {
        + compile(source_path: Path, output_path: Path): CompileResult
    }

    class GccAdapter {
        - gcc_binary_path: str
        + compile(source_path: Path, output_path: Path): CompileResult
        - parse_gcc_stderr(stderr: str): str
    }

    class JavacAdapter {
        - javac_binary_path: str
        + compile(source_path: Path, output_path: Path): CompileResult
        - parse_javac_stderr(stderr: str): str
    }

    class ResourceMonitor {
        - process: psutil.Process
        - max_ram_bytes: int
        - timeout_seconds: float
        + start_monitoring(pid: int): void
        + poll_usage(): ResourceUsage
        + enforce_kill_if_exceeded(): void
    }

    class CompileResult {
        + is_success: bool
        + executable_path: Path
        + compile_error_log: str
        + error_code: str
    }

    class ExecutionResult {
        + exit_code: int
        + stdout_data: str
        + stderr_data: str
        + execution_time_ms: float
        + memory_used_mb: float
        + is_timeout: bool
        + is_memory_exceeded: bool
    }

    BaseRunner <|-- CRunner
    BaseRunner <|-- JavaRunner
    BaseRunner <|-- PythonRunner
    BaseRunner <|-- WebRunner

    RunnerFactory ..> BaseRunner : <<creates>>
    RunnerFactory ..> CRunner : <<instantiates>>
    RunnerFactory ..> JavaRunner : <<instantiates>>
    RunnerFactory ..> PythonRunner : <<instantiates>>
    RunnerFactory ..> WebRunner : <<instantiates>>

    CompilerAdapter <|.. GccAdapter
    CompilerAdapter <|.. JavacAdapter

    CRunner o-- CompilerAdapter
    JavaRunner o-- CompilerAdapter
    BaseRunner --> ResourceMonitor : uses
    BaseRunner ..> CompileResult : produces
    BaseRunner ..> ExecutionResult : produces
}

' ==============================================================================
' PHÂN HỆ 2: GRADING CORE & OUTPUT MATCHING SUBSYSTEM (DESKTOP BUSINESS LAYER)
' Mẫu thiết kế áp dụng:
'   - Behavioral Pattern: Strategy Pattern (MatchingStrategy & 7 Concrete Strategies)
' ==============================================================================
package "Phân Hệ 2: Grading Core & Output Matching Subsystem" #EDE7F6 {

    class MatchResult <<dataclass>> {
        + is_matched: bool
        + verdict: str
        + score_ratio: float
        + diff_details: Optional[str]
        + message: Optional[str]
    }

    interface IMatchingStrategy <<Behavioral - Strategy>> {
        + {abstract} compare(actual: str, expected: str): MatchResult
    }

    class ExactMatchStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class IgnoreWhitespaceStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class CaseInsensitiveStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class FloatingPointToleranceStrategy {
        - tolerance_epsilon: float
        + compare(actual: str, expected: str): MatchResult
    }

    class UnorderedTokensStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class RegexPatternStrategy {
        + compare(actual: str, expected: str): MatchResult
    }

    class SpecialJudgeStrategy {
        - checker_script_path: Path
        + compare(actual: str, expected: str): MatchResult
    }

    class FlexibleMatchingStrategy {
        - ignore_whitespace: bool
        - case_insensitive: bool
        - floating_tolerance: bool
        - unordered_tokens: bool
        - regex_pattern: bool
        - special_judge: bool
        + compare(actual: str, expected: str): MatchResult
    }

    class MatchingContext {
        - _strategy: IMatchingStrategy
        + STRATEGY_REGISTRY: Dict[str, Type]
        + set_strategy(strategy: IMatchingStrategy): void
        + set_strategy_by_name(strategy_name: str): void
        + compare(actual: str, expected: str): MatchResult
    }

    class BatchGradingManager {
        - worker_pool_size: int
        - matching_context: MatchingContext
        + load_submissions_directory(dir_path: Path): List[Submission]
        + load_students_csv(csv_path: Path): List[Submission]
        + execute_batch_grading(session_id: str): List[GradingResult]
        + export_results_csv(results: List[GradingResult], output_path: Path): void
    }

    class Submission {
        + student_id: str
        + student_name: str
        + source_file_path: Path
        + programming_language: str
        + total_score: float
        + status: str
    }

    class TestCase {
        + id: int
        + class_id: int
        + question_number: int
        + input_data: str
        + expected_output: str
        + score_weight: float
        + time_limit_ms: int
        + memory_limit_mb: int
        + matching_strategy: str
        + is_hidden: bool
    }

    class GradingResult {
        + id: int
        + submission_id: int
        + test_case_id: int
        + status: str
        + actual_output: str
        + execution_time_ms: float
        + memory_used_mb: float
        + score: float
        + diff_details: str
        + manual_override_score: float
        + manual_override_reason: str
        + graded_at: datetime
    }

    class WebGradingResult {
        + submission_id: str
        + website_url: str
        + github_url: str
        + grading_mode: str
        + entrypoint_file: str
        + score_dom: float
        + score_lint: float
        + score_func: float
        + score_ui: float
        + final_score: float
        + final_verdict: str
        + screenshot_path: str
        + rubric_log: str
        + ai_feedback: str
    }

    IMatchingStrategy <|.. ExactMatchStrategy
    IMatchingStrategy <|.. IgnoreWhitespaceStrategy
    IMatchingStrategy <|.. CaseInsensitiveStrategy
    IMatchingStrategy <|.. FloatingPointToleranceStrategy
    IMatchingStrategy <|.. UnorderedTokensStrategy
    IMatchingStrategy <|.. RegexPatternStrategy
    IMatchingStrategy <|.. SpecialJudgeStrategy
    IMatchingStrategy <|.. FlexibleMatchingStrategy
    IMatchingStrategy ..> MatchResult : returns

    MatchingContext o-- IMatchingStrategy
    BatchGradingManager *-- MatchingContext
    BatchGradingManager --> RunnerFactory : requests runner
    BatchGradingManager o-- Submission
    BatchGradingManager o-- TestCase
    BatchGradingManager ..> GradingResult : generates
    BatchGradingManager ..> WebGradingResult : generates
}

' ==============================================================================
' PHÂN HỆ 3: CENTRAL BACKEND & AI GATEWAY SUBSYSTEM (NESTJS SERVICE)
' Mẫu thiết kế & Kiến trúc:
'   - Facade / Service Layer Pattern
'   - Role-Based Access Control (RBAC) & OAuth2 JWT
' ==============================================================================
package "Phân Hệ 3: Central Backend & AI Gateway Subsystem (NestJS Service)" #E3F2FD {

    class AuthController {
        - auth_service: AuthService
        + login(credentials: OAuth2PasswordRequestForm): TokenResponse
        + refresh_token(token: str): TokenResponse
    }

    class AIGatewayController {
        - quota_manager: QuotaManager
        - gemini_service: GeminiGatewayService
        + generate_testcases(prompt_payload: TestcaseGenRequest): List[TestCase]
        + review_code_error(code_payload: CodeReviewRequest): AIReviewResponse
        + check_plagiarism_semantic(pair_payload: PlagiarismPairRequest): PlagiarismReport
    }

    class AuthService {
        - secret_key: str
        - algorithm: str
        + authenticate_user(username: str, password: str): User
        + create_access_token(data: dict): str
        + verify_jwt_token(token: str): TokenPayload
    }

    class QuotaManager {
        - daily_token_limit: int
        + check_quota_available(user_id: str): bool
        + consume_quota(user_id: str, tokens_used: int): void
        + get_remaining_quota(user_id: str): int
    }

    class GeminiGatewayService <<Service Layer / AI Gateway>> {
        - api_key: str
        - model_name: str
        + call_generate_boundary_testcases(statement: str): List[TestCase]
        + call_pedagogical_code_review(source_code: str, wrong_test: TestCase): str
        + call_semantic_plagiarism_analysis(code_a: str, code_b: str): PlagiarismReport
    }

    class User <<Entity>> {
        + user_id: str
        + username: str
        + password_hash: str
        + full_name: str
        + role: str
        + is_active: bool
        + is_deleted: bool
        + daily_quota: int
    }

    class AIQuotaLog <<Entity>> {
        + log_id: str
        + user_id: str
        + feature_used: str
        + tokens_consumed: int
        + is_deleted: bool
        + timestamp: datetime
    }

    AuthController --> AuthService
    AIGatewayController --> QuotaManager
    AIGatewayController --> GeminiGatewayService

    AuthService ..> User : manages
    QuotaManager ..> AIQuotaLog : persists
}

' ==============================================================================
' LIÊN KẾT GIAO TIẾP GIỮA CÁC PHÂN HỆ (CROSS-SUBSYSTEM RELATIONSHIPS)
' ==============================================================================

' Desktop Batch Grading Manager kết nối với Sandbox Engine
BatchGradingManager --> BaseRunner : executes code

' Desktop App kết nối mạng với Backend API qua RESTful Calls (Chỉ cho Auth và AI Gateway)
MatchingContext ..> AIGatewayController : HTTP POST /ai/generate-testcases & /ai/code-review

' Ghi chú làm nổi bật 3 Mẫu thiết kế bắt buộc theo Rubric SWD392
note top of RunnerFactory
  <b>1. Creational Pattern: Factory Method</b>
  Tự động nhận diện đuôi file (.c, .java, .py)
  để sản xuất đối tượng Runner tương ứng.
end note

note top of CompilerAdapter
  <b>2. Structural Pattern: Adapter Pattern</b>
  Đồng nhất hóa giao diện biên dịch và chuẩn hóa
  mã lỗi stderr giữa GCC, Javac và Python.
end note

note top of IMatchingStrategy
  <b>3. Behavioral Pattern: Strategy Pattern</b>
  Cung cấp 7 chiến lược so khớp đầu ra linh hoạt
  kết hợp đa cờ qua FlexibleMatchingStrategy lúc runtime.
end note

@enduml
