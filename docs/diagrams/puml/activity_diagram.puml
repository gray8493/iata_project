@startuml
!theme plain
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam conditionStyle insidediamond

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

title Sơ Đồ Hoạt Động Quy Trình Chấm Bài & Tích Hợp AI (Activity Diagram - End-to-End Grading & AI Pipeline)\nHệ Sinh Thái AITA (Desktop App, Sandbox Runner, FastAPI Backend & Gemini AI)

' ==============================================================================
' ĐỊNH NGHĨA CÁC VÙNG PHÂN QUYỀN (SWIMLANES)
' ==============================================================================

|#E1F5FE|Giảng viên (Instructor)|
|#EDE7F6|Desktop App UI (PyQt6 Client)|
|#E8F5E9|Desktop Core & Sandbox Runner (Local Engine)|
|#FFF3E0|Web Server Backend (FastAPI Central API)|
|#FCE4EC|Google Gemini AI Hub (Cloud AI)|

' ==============================================================================
' 1. GIAI ĐOẠN KHỞI ĐỘNG & THIẾT LẬP ĐỢT CHẤM (SETUP & CONFIGURATION)
' ==============================================================================

|Giảng viên (Instructor)|
start
:Khởi động ứng dụng Desktop App;
:Đăng nhập tài khoản giảng viên;

|Desktop App UI (PyQt6 Client)|
:Gửi thông tin xác thực lên máy chủ;

|Web Server Backend (FastAPI Central API)|
:Xác thực OAuth2 & Cấp JWT Token;

|Desktop App UI (PyQt6 Client)|
:Lưu JWT Token vào phiên làm việc (SessionManager);
:Hiển thị Màn hình Điều khiển Chấm bài;

|Giảng viên (Instructor)|
:Chọn Môn học & Nạp danh sách bài nộp từ file **students.csv** (UC-08);

|Desktop App UI (PyQt6 Client)|
:Đọc và thẩm định file CSV (chuẩn 2 cột: MSSV, File bài làm);
:Hiển thị bảng danh sách sinh viên;

|Giảng viên (Instructor)|
if (Nguồn tạo Bộ Testcase kiểm thử?) then ([Tự nhập / Nạp JSON (UC-09)])
    :Nhập thủ công các cặp INPUT / OUTPUT kỳ vọng;
else ([Tự động sinh bằng AI (UC-10)])
    :Dán mô tả đề bài & các ràng buộc bài toán;
    :Bấm nút **[✨ Sinh Testcase bằng AI]**;

    |Desktop App UI (PyQt6 Client)|
    :Đóng gói prompt gửi yêu cầu POST /api/v1/ai/generate-testcases;

    |Web Server Backend (FastAPI Central API)|
    :Thẩm định JWT Token & Kiểm tra hạn ngạch (AI Quota);
    if (Hạn ngạch Quota còn khả dụng?) then ([Hết Quota])
        :Trả về HTTP 429 Too Many Requests;
        |Desktop App UI (PyQt6 Client)|
        :Báo lỗi hết quota; Chuyển sang nạp testcase thủ công;
        |Giảng viên (Instructor)|
        :Nhập thủ công testcase;
    else ([Còn Quota])
        :Trừ lượt hạn ngạch;
        :Chuyển tiếp prompt chuẩn hóa sang Google Gemini;

        |Google Gemini AI Hub (Cloud AI)|
        :Phân tích đề bài & Sinh 5-10 cặp [INPUT, OUTPUT biên];

        |Web Server Backend (FastAPI Central API)|
        :Nhận kết quả JSON testcase từ Gemini;
        :Trả về HTTP 200 OK cho Desktop App;

        |Desktop App UI (PyQt6 Client)|
        :Hiển thị bảng duyệt trước (Preview Table);

        |Giảng viên (Instructor)|
        :Kiểm tra, tick chọn các testcase đạt chuẩn & Lưu;
    endif
endif

|Desktop Core & Sandbox Runner (Local Engine)|
:Lưu bộ Testcase chuẩn vào CSDL SQLite cục bộ;

|Giảng viên (Instructor)|
:Chọn 1 trong 7 Chiến lược So khớp đầu ra (MatchingStrategy - UC-11);
note right
  7 Chiến lược so khớp:
  1. Exact Match
  2. Ignore Whitespace
  3. Case-Insensitive
  4. Floating-Point Tolerance
  5. Unordered Tokens
  6. Regex Pattern Match
  7. Special Judge (checker.py)
end note

' ==============================================================================
' 2. GIAI ĐOẠN THỰC THI CHẤM BÀI TỰ ĐỘNG HÀNG LOẠT (OFFLINE PIPELINE - UC-12)
' ==============================================================================

:Bấm nút **[BẮT ĐẦU CHẤM BÀI]**;

|Desktop App UI (PyQt6 Client)|
:Kích hoạt luồng chạy nền QThread Worker Pool;
:Khởi tạo thanh tiến độ (Progress Bar = 0%) & Bảng log mini;

|Desktop Core & Sandbox Runner (Local Engine)|
:Khởi tạo ProcessPoolExecutor (Chạy song song 4-8 bài đồng thời);
note left
  Quá trình chấm chạy hoàn toàn OFFLINE trên máy cục bộ,
  dồn 100% CPU để tối ưu hiệu năng (15-30 giây cho 45 bài).
end note

while (Còn bài nộp sinh viên trong hàng đợi?) is ([Có])
    :Lấy bài nộp tiếp theo từ hàng đợi;
    :Nhận diện các file câu hỏi độc lập (Q1, Q2, Q3 có hàm main());
    
    :RunnerFactory khởi tạo Runner theo ngôn ngữ (C / Java / Python);
    :Biên dịch mã nguồn sinh viên sang file thực thi tạm thời;

    if (Biên dịch thành công?) then ([Lỗi biên dịch])
        :Gán trạng thái **CE (Compile Error)**;
        :Thu thập thông báo lỗi cú pháp từ stderr;
        :Điểm câu hỏi = 0.0;
    else ([Thành công])
        while (Còn testcase kiểm thử cho câu này?) is ([Có])
            :Khởi chạy subprocess thực thi binary qua hàm main();
            :Truyền dữ liệu INPUT qua luồng stdin;
            
            :psutil giám sát tài nguyên CPU / RAM theo thời gian thực;
            
            if (Thời gian chạy >= Time Limit (1000ms)?) then ([Quá giờ])
                :Kill tiến trình;
                :Gán verdict **TLE (Time Limit Exceeded)**;
            elseif (RAM tiêu thụ >= Memory Limit (256MB)?) then ([Tràn RAM])
                :Kill tiến trình;
                :Gán verdict **MLE (Memory Limit Exceeded)**;
            elseif (Exit Code != 0?) then ([Lỗi Runtime])
                :Gán verdict **RE (Runtime Error)**;
            else ([Chạy hợp lệ])
                :Thu nhận OUTPUT thực tế từ luồng stdout;
                :Áp dụng Strategy Pattern so khớp OUTPUT thực tế với kỳ vọng;
                
                if (Kết quả so khớp trùng khớp?) then ([Khớp])
                    :Gán verdict **AC (Accepted)**;
                    :Cộng điểm testcase đó;
                else ([Không khớp])
                    :Gán verdict **WA (Wrong Answer)**;
                endif
            endif
        endwhile ([Hết testcase])
    endif

    :Tính tổng điểm bài thi & Lưu chi tiết vào SQLite cục bộ;
    
    |Desktop App UI (PyQt6 Client)|
    :Phát tín hiệu pyqtSignal cập nhật Progress Bar & Bảng điểm thời gian thực (UC-13);

    |Desktop Core & Sandbox Runner (Local Engine)|
endwhile ([Hết danh sách])

|Desktop App UI (PyQt6 Client)|
:Thanh tiến độ đạt 100%;
:Hiển thị thông báo "Hoàn thành chấm 45 bài trong 18.2 giây";
:Làm mới toàn bộ Bảng điểm chính;

' ==============================================================================
' 3. GIAI ĐOẠN ĐÁNH GIÁ, PHÂN TÍCH AI & KIỂM TRA ĐẠO VĂN
' ==============================================================================

|Giảng viên (Instructor)|
:Kiểm tra tổng quan bảng kết quả điểm;

fork
    ' NHÁNH 1: PHÂN TÍCH LỖI SƯ PHẠM BẰNG AI (ON-DEMAND - UC-16)
    if (Xem xét bài thi bị lỗi logic WA?) then ([Có bài WA cần hỗ trợ])
        :Nhấp đúp chuột vào sinh viên bị WA để mở Submission Inspector (UC-14);
        
        |Desktop App UI (PyQt6 Client)|
        :Hiển thị Code Viewer có highlight cú pháp & Bảng so sánh Diff Output;
        
        |Giảng viên (Instructor)|
        :Bấm nút **[✨ AI Phân tích lỗi]** (Cơ chế On-Demand);
        
        |Desktop App UI (PyQt6 Client)|
        :Đóng gói mã nguồn & testcase sai gửi lên Web Backend;
        
        |Web Server Backend (FastAPI Central API)|
        :Kiểm tra token & Trừ quota AI;
        :Gửi prompt sư phạm sang Google Gemini;
        
        |Google Gemini AI Hub (Cloud AI)|
        :Phân tích nguyên nhân lỗi logic;
        :Sinh nhận xét sư phạm ngắn (3-5 câu gợi ý tư duy, không giải sẵn);
        
        |Desktop App UI (PyQt6 Client)|
        :Hiển thị bản nháp nhận xét AI lên màn hình;
        
        |Giảng viên (Instructor)|
        :Duyệt, chỉnh sửa nhận xét & Nhấn **[Lưu nhận xét]**;
        
        |Desktop Core & Sandbox Runner (Local Engine)|
        :Lưu nhận xét vào trường teacher_feedback trong SQLite;
    else ([Không cần])
    endif

fork again
    ' NHÁNH 2: KIỂM TRA ĐẠO VĂN 2 VÒNG (UC-17)
    if (Yêu cầu kiểm tra gian lận thi cử?) then ([Quét Đạo Văn])
        :Nhấn nút **[Quét Đạo Văn]** & Đặt ngưỡng cảnh báo (>= 80%);
        
        |Desktop Core & Sandbox Runner (Local Engine)|
        :Tiền xử lý mã nguồn: Loại bỏ comment, chuẩn hóa tên biến, sinh cây AST;
        :Chạy thuật toán Winnowing so khớp O(N^2) toàn bộ các cặp bài trong lớp;
        note left
          Vòng 1 chạy 100% OFFLINE trên máy trạm,
          hoàn thành chỉ trong 0.5 giây mà không tốn token AI.
        end note
        
        |Desktop App UI (PyQt6 Client)|
        :Hiển thị Ma trận tương đồng (Similarity Matrix);
        
        if (Có cặp bài nộp vượt ngưỡng >= 80%?) then ([Có nghi vấn])
            |Giảng viên (Instructor)|
            :Bấm nút **[✨ AI Phân tích bằng chứng]** (Vòng 2 - AI Semantic);
            
            |Web Server Backend (FastAPI Central API)|
            :Chuyển tiếp cấu trúc code 2 bài nghi vấn sang Gemini AI;
            
            |Google Gemini AI Hub (Cloud AI)|
            :Phân tích thủ thuật đảo hàm, đổi tên biến, code rác;
            :Trích xuất biên bản bằng chứng sao chép;
            
            |Desktop App UI (PyQt6 Client)|
            :Mở Side-by-side Diff Viewer tô sáng các đoạn code trùng khớp;
            
            |Giảng viên (Instructor)|
            :Xác nhận ghi nhận biên bản kỷ luật học thuật;
        else ([Không có])
            |Desktop App UI (PyQt6 Client)|
            :Thông báo "Không phát hiện nghi vấn sao chép bất thường";
        endif
    else ([Bỏ qua])
    endif
end fork

' ==============================================================================
' 4. GIAI ĐOẠN BÁO CÁO & ĐỒNG BỘ DỮ LIỆU CLOUD (UC-18 & UC-19)
' ==============================================================================

|Giảng viên (Instructor)|
:Nhấn nút **[Xuất Báo Cáo]** (UC-18);

|Desktop App UI (PyQt6 Client)|
:Hỏi định dạng xuất: File CSV chuẩn 7 cột hoặc Bảng điểm Excel (.xlsx);

|Giảng viên (Instructor)|
:Chọn định dạng mong muốn & Chọn thư mục lưu trên máy trạm;

|Desktop Core & Sandbox Runner (Local Engine)|
:Truy xuất dữ liệu SQLite;
:Ghi file **results.csv** hoặc **Gradebook.xlsx** (kèm điểm, verdict, nhận xét AI);

|Desktop App UI (PyQt6 Client)|
:Thông báo xuất file thành công kèm nút [Mở Thư Mục];

|Giảng viên (Instructor)|
:Nhấn nút **[Đồng bộ lên Cloud]** (UC-19);

|Desktop App UI (PyQt6 Client)|
:Đóng gói toàn bộ bảng điểm & logs thành payload JSON;
:Gửi yêu cầu POST /api/v1/sync/grading-session kèm JWT Token;

|Web Server Backend (FastAPI Central API)|
:Xác thực danh tính giảng viên;
:Lưu đợt chấm vào CSDL trung tâm qua SQLAlchemy ORM;
:Trả về HTTP 200 OK kèm sync_id;

|Desktop App UI (PyQt6 Client)|
:Cập nhật trạng thái đợt chấm thành "Đã đồng bộ lên Cloud" (biểu tượng đám mây xanh);

|Giảng viên (Instructor)|
:Hoàn tất phiên làm việc;
stop

@enduml
