@startuml
!pragma layout smetana
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 12
skinparam packageStyle rectangle

' Styling theme consistent with AITA architecture diagrams
skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    BorderThickness 1.5
    FontSize 11
    FontStyle bold
    RoundCorner 8
}

skinparam artifact {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontSize 10
}

skinparam component {
    BackgroundColor #F1F8E9
    BorderColor #2E7D32
    FontSize 10
    RoundCorner 6
}

skinparam database {
    BackgroundColor #EDE7F6
    BorderColor #512DA8
    FontSize 11
    FontStyle bold
}

skinparam interface {
    BackgroundColor #E0F2F1
    BorderColor #00796B
    FontSize 10
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

skinparam queue {
    BackgroundColor #FBE9E7
    BorderColor #D84315
    FontSize 10
}

title Sơ Đồ Triển Khai Hệ Điều Hành & Máy Chủ (System Deployment Diagram) - AITA Ecosystem\nTích Hợp Hạ Tầng Đa Nền Tảng (Windows Desktop / Linux Server / Cloud AI) & 3 Mẫu Thiết Kế

' ==============================================================================
' 1. CLIENT WORKSTATION TIER (MÁY TRẠM CỦA GIẢNG VIÊN - WINDOWS OS)
' ==============================================================================
node "Instructor Workstation\n<<Client Machine>>\n[HĐH: Windows 10 / 11 64-bit]\nCPU: Intel/AMD x86-64 (≥ 4 Cores) | RAM: ≥ 8GB" as InstructorNode #E3F2FD {

    node "Desktop Application Runtime\n<<Execution Environment>>\n[Python 3.11 Runtime / PyInstaller Virtual Env]" as DesktopEnv #FFFFFF {
        
        artifact "AITA.exe\n<<Standalone Executable>>\n[PyQt6 / PySide6 Native GUI]" as AitaArtifact {
            component "Presentation & Controller\n(MainWindow, WorkerThread)" as DesktopUI
            
            ' --- 3 MẪU THIẾT KẾ ĐƯỢC DEPLOY TẠI TẦNG NÀY ---
            component "Grading Core Engine\n<<Engine Core>>" as GradingEngine {
                component "RunnerFactory\n<<Creational - Factory Method>>" as CompFactory
                component "CompilerAdapter Suite\n<<Structural - Adapter>>\n[GccAdapter, JavacAdapter]" as CompAdapter
                component "MatchingEngineContext\n<<Behavioral - Strategy>>\n[7 Matching Strategies]" as CompStrategy
            }
            
            component "Network Sync Client\n(HTTPX / REST Client)" as SyncClient
        }
    }

    node "Local Compilers & Runtimes Toolchain\n<<Execution Environment>>" as LocalToolchain #F9FBE7 {
        component "MinGW-w64 / GCC 13+\n(C Compiler: gcc.exe)" as GccBin
        component "OpenJDK 17 / 21\n(Java Compiler: javac.exe / java.exe)" as JavaBin
        component "Python 3.10+ Runtime\n(python.exe & ast checker)" as PyBin
        component "psutil Process Monitor\n(Enforce RAM Limit & Anti-Freeze Kill)" as PsutilWatcher
    }

    node "Local File Storage\n<<Execution Environment / Local NTFS>>" as LocalStorage #ECEFF1 {
        database "local_cache.db\n<<SQLite 3 Database>>\n(Offline Testcases & Temp Results)" as LocalDB
        artifact "Input Submissions\n[students.csv, *.c, *.java, *.py]" as StudentFiles
        artifact "Output Grade Sheet\n[results.csv (7 columns)]" as ResultCSV
    }

    ' Nội bộ liên kết máy trạm
    DesktopUI --> GradingEngine : triggers grading workflow
    CompFactory ..> CompAdapter : initializes adapters
    CompAdapter --> GccBin : invokes CLI via Subprocess
    CompAdapter --> JavaBin : invokes CLI via Subprocess
    CompAdapter --> PyBin : invokes CLI via Subprocess
    GradingEngine --> PsutilWatcher : monitors RAM & enforces Timeout
    GradingEngine --> CompStrategy : evaluates stdout vs expected
    DesktopUI --> LocalDB : reads/writes offline cache
    DesktopUI --> StudentFiles : reads submissions
    DesktopUI --> ResultCSV : exports CSV report
}

' ==============================================================================
' 2. ADMINISTRATOR TERMINAL TIER (MÁY TRẠM QUẢN TRỊ VIÊN)
' ==============================================================================
node "Administrator Workstation\n<<Client Machine>>\n[HĐH: Windows / macOS / Linux]\nWeb Browser: Chrome / Edge / Firefox" as AdminNode #E1F5FE {
    artifact "Admin Web Dashboard\n<<Web Frontend App>>\n[Next.js 14+ / React SPA]" as WebAdminArtifact {
        component "User & Role Management UI" as UIUser
        component "AI Quota & Token Monitor UI" as UIQuota
        component "Audit Logs & Reports UI" as UIReports
    }
}

' ==============================================================================
' 3. APPLICATION SERVER TIER (MÁY CHỦ TRUNG TÂM - LINUX OS / DOCKER CONTAINER)
' ==============================================================================
node "Central Application Server Host\n<<Production Server Node>>\n[HĐH: Ubuntu Linux 22.04 LTS (x86-64)]\nCPU: 4 vCPU | RAM: 8GB | Storage: 80GB SSD" as ServerNode #E8F5E9 {

    node "Reverse Proxy & Edge Ingress\n<<Execution Environment>>" as ProxyEnv #FFFFFF {
        component "Nginx Reverse Proxy / Ingress\n[TLS 1.3 Termination, Rate Limiting]\nPorts: 80 (HTTP redirect), 443 (HTTPS)" as NginxProxy
    }

    node "Containerized Application Pod\n<<Docker / Podman Container>>" as AppContainer #F1F8E9 {
        
        artifact "central-backend.service\n<<Backend Application Artifact>>\n[NestJS 10 / Node.js 20 LTS]" as BackendArtifact {
            component "API Gateway & Router\n(Swagger / OpenAPI Endpoint)" as ApiRouter
            component "Auth & RBAC Guard\n(Passport-JWT, Bcrypt Validator)" as AuthGuard
            component "AI Gateway & Quota Guard\n(Token Counter & Limiter)" as AIGateway
            component "Grading Sync Service\n(Session & Submissions Handler)" as SyncService
            component "ORM Engine\n(Prisma 5)" as OrmEngine
        }
    }

    node "Central Cache & Queue\n<<Docker Container>>" as CacheNode #FFF3E0 {
        database "Redis 7.x In-Memory\n<<Cache & Rate Limit Store>>\n(Session JWT Blacklist & AI Token Limits)" as RedisDB
    }
}

' ==============================================================================
' 4. DATABASE SERVER TIER (MÁY CHỦ CƠ SỞ DỮ LIỆU TRUNG TÂM)
' ==============================================================================
node "Database Server Node\n<<Central Database Host>>\n[HĐH: Ubuntu Linux 22.04 LTS / Managed DB Service]\nStorage: 100GB High-IOPS NVMe" as DbNode #EDE7F6 {
    
    node "RDBMS Environment\n<<Execution Environment>>" as RdbmsEnv #FFFFFF {
        database "aita_central_db\n<<PostgreSQL 16 RDBMS>>" as PostgresDB {
            artifact "Tables Schema:\n- users\n- ai_quota_configs, ai_quota_logs\n- refresh_tokens" as DbSchema
        }
    }
}

' ==============================================================================
' 5. EXTERNAL CLOUD AI SERVICE TIER (DỊCH VỤ TRÍ TUỆ NHÂN TẠO ĐÁM MÂY)
' ==============================================================================
node "Google Cloud Platform (GCP)\n<<Public Cloud Infrastructure>>\nRegion: us-central1 / asia-southeast1" as CloudAINode #FFFDE7 {
    node "Google AI Foundation Services\n<<Managed Cloud PaaS>>" as GeminiEnv #FFFFFF {
        component "Google Gemini 3.8 Flash API\n<<LLM Inference Endpoint>>\n[generativelanguage.googleapis.com]" as GeminiAPI
    }
}

' ==============================================================================
' CÁC KẾT NỐI MẠNG, GIAO THỨC & CỔNG TRUYỀN THÔNG (NETWORK PROTOCOLS & PORTS)
' ==============================================================================

' Kết nối từ Admin Browser đến Reverse Proxy
AdminNode -- NginxProxy : **HTTPS / TLS 1.3**\n[TCP Port 443]\n(REST API & Static Web Assets)

' Kết nối từ Desktop Client Giảng viên đến Reverse Proxy
SyncClient -- NginxProxy : **HTTPS / TLS 1.3**\n[TCP Port 443]\n(JSON REST API, Bearer JWT Auth)

' Reverse proxy định tuyến nội bộ vào Backend Container
NginxProxy -- ApiRouter : **HTTP / Reverse Proxy**\n[Unix Socket / TCP 3000]\n(Internal Bridge Network)

' Backend giao tiếp với Redis Cache
BackendArtifact -- RedisDB : **Redis Protocol (RESP)**\n[TCP Port 6379]\n(Rate Limiting & Token Counters)

' Backend kết nối CSDL PostgreSQL
OrmEngine -- PostgresDB : **PostgreSQL Native Protocol (TCP/IP)**\n[Port 5432 / SSL Encrypted]\n(Prisma Connection Pool)

' Backend gọi Google Gemini AI Cloud
AIGateway -- GeminiAPI : **HTTPS / REST & gRPC**\n[TCP Port 443 / TLS 1.3]\n(Gemini SDK, Secure API Key Header)

' ==============================================================================
' GHI CHÚ KIẾN TRÚC & MẪU THIẾT KẾ (DESIGN PATTERNS SPECIFICATION NOTES)
' ==============================================================================
note bottom of InstructorNode
    <b>ĐẶC TẢ MÁY TRẠM GIẢNG VIÊN (DESKTOP CLIENT):</b>
    • <b>Hệ điều hành:</b> Windows 10/11 x64, vận hành theo mô hình <i>Offline-First</i>.
    • <b>Triển khai 3 Design Patterns:</b>
       - <i>Factory Method:</i> RunnerFactory nhận diện đuôi file (.c, .java, .py) để sinh đúng Runner.
       - <i>Adapter Pattern:</i> CompilerAdapter chuẩn hóa CLI và mã lỗi của GCC, Javac, Python.
       - <i>Strategy Pattern:</i> MatchingEngineContext thực thi 7 thuật toán so khớp output.
    • <b>Sandbox An Toàn:</b> Subprocess cô lập kết hợp psutil để diệt tiến trình lặp vô hạn (TLE) và tràn RAM (MLE).
end note

note bottom of ServerNode
    <b>ĐẶC TẢ MÁY CHỦ TRUNG TÂM (CENTRAL BACKEND):</b>
    • <b>Hệ điều hành:</b> Ubuntu Linux 22.04 LTS chạy trên Docker Container.
    • <b>Bảo mật & Phân quyền:</b> Nginx chặn SSL/TLS 1.3, NestJS bảo vệ endpoint qua JWT RBAC Guard.
    • <b>AI Gateway Hub:</b> Đọc API Key từ biến môi trường; kiểm soát Quota và đếm token tiêu thụ,
      chống lộ key và chống cạn kiệt ngân sách trường.
end note

note bottom of DbNode
    <b>CƠ SỞ DỮ LIỆU TẬP TRUNG:</b>
    • <b>PostgreSQL 16:</b> Lưu trữ dữ liệu quan hệ, ACID transaction, soft delete.
    • <b>Sao lưu & Phục hồi:</b> Định kỳ pg_dump và backup snapshot hàng ngày.
end note

@enduml
