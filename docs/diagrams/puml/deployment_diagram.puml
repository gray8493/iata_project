@startuml
!pragma layout smetana
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 12
skinparam packageStyle rectangle

' Styling theme consistent with AITA architecture diagrams
skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    BorderThickness 1.5
    FontSize 11
    FontStyle bold
    RoundCorner 8
}

skinparam artifact {
    BackgroundColor #FFFDE7
    BorderColor #FBC02D
    FontSize 10
}

skinparam component {
    BackgroundColor #F1F8E9
    BorderColor #2E7D32
    FontSize 10
    RoundCorner 6
}

skinparam database {
    BackgroundColor #EDE7F6
    BorderColor #512DA8
    FontSize 11
    FontStyle bold
}

skinparam interface {
    BackgroundColor #E0F2F1
    BorderColor #00796B
    FontSize 10
}

skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontSize 10
}

skinparam queue {
    BackgroundColor #FBE9E7
    BorderColor #D84315
    FontSize 10
}

title Sơ Đồ Triển Khai Hệ Điều Hành & Máy Chủ (System Deployment Diagram) - AITA Ecosystem\nTích Hợp Hạ Tầng Đa Nền Tảng (Windows Desktop / Linux Server / Cloud AI) & 3 Mẫu Thiết Kế

' ==============================================================================
' 1. CLIENT WORKSTATION TIER (MÁY TRẠM CỦA GIẢNG VIÊN - WINDOWS OS)
' ==============================================================================
node "Instructor Workstation\n<<Client Machine>>\n[HĐH: Windows 10 / 11 64-bit]\nCPU: Intel/AMD x86-64 (≥ 4 Cores) | RAM: ≥ 8GB" as InstructorNode #E3F2FD {

    node "Desktop Application Runtime\n<<Execution Environment>>\n[Python 3.11 Runtime / PyInstaller Virtual Env]" as DesktopEnv #FFFFFF {
        
        artifact "AITA.exe\n<<Standalone Executable>>\n[PyQt6 Native GUI]" as AitaArtifact {
            component "Presentation & Controller\n(MainWindow, WorkerThread)" as DesktopUI
            
            ' --- 3 MẪU THIẾT KẾ ĐƯỢC DEPLOY TẠI TẦNG NÀY ---
            component "Grading Core Engine\n<<Engine Core>>" as GradingEngine {
                component "RunnerFactory\n<<Creational - Factory Method>>" as CompFactory
                component "CompilerAdapter Suite\n<<Structural - Adapter>>\n[GccAdapter, JavacAdapter]" as CompAdapter
                component "MatchingContext\n<<Behavioral - Strategy>>\n[7 Strategies + FlexibleMatchingStrategy]" as CompStrategy
            }
            
            component "Network Sync Client\n(HTTPX / REST Client)" as SyncClient
        }
    }

    node "Local Compilers & Runtimes Toolchain\n<<Execution Environment>>" as LocalToolchain #F9FBE7 {
        component "MinGW-w64 / GCC 13+\n(C Compiler: gcc.exe)" as GccBin
        component "OpenJDK 17 / 21\n(Java Compiler: javac.exe / java.exe)" as JavaBin
        component "Python 3.10+ Runtime\n(python.exe & ast checker)" as PyBin
        component "psutil Process Monitor\n(Enforce RAM Limit & Anti-Freeze Kill)" as PsutilWatcher
    }

    node "Local File Storage\n<<Execution Environment / Local NTFS>>" as LocalStorage #ECEFF1 {
        database "local_grading.db\n<<SQLite 3 Database>>\n(Offline Testcases & Grading Results)" as LocalDB
        artifact "Input Submissions\n[students.csv, *.c, *.java, *.py]" as StudentFiles
        artifact "Output Grade Sheet\n[results.csv (7 columns)]" as ResultCSV
    }

    ' Nội bộ liên kết máy trạm
    DesktopUI --> GradingEngine : triggers grading workflow
    CompFactory ..> CompAdapter : initializes adapters
    CompAdapter --> GccBin : invokes CLI via Subprocess
    CompAdapter --> JavaBin : invokes CLI via Subprocess
    CompAdapter --> PyBin : invokes CLI via Subprocess
    GradingEngine --> PsutilWatcher : monitors RAM & enforces Timeout
    GradingEngine --> CompStrategy : evaluates stdout vs expected
    DesktopUI --> LocalDB : reads/writes offline cache
    DesktopUI --> StudentFiles : reads submissions
    DesktopUI --> ResultCSV : exports CSV report
}

' ==============================================================================
' 2. ADMINISTRATOR TERMINAL TIER (MÁY TRẠM QUẢN TRỊ VIÊN)
' ==============================================================================
node "Administrator Workstation\n<<Client Machine>>\n[HĐH: Windows / macOS / Linux]\nWeb Browser: Chrome / Edge / Firefox" as AdminNode #E1F5FE {
    artifact "Admin Web Dashboard\n<<Web Frontend App>>\n[Next.js 14+ / React SPA]" as WebAdminArtifact {
        component "User & Role Management UI" as UIUser
        component "AI Quota & Token Monitor UI" as UIQuota
        component "Audit Logs & Reports UI" as UIReports
    }
}

' ==============================================================================
' 3. APPLICATION SERVER TIER (DỊCH VỤ ĐÁM MÂY - RENDER.COM CLOUD PAAS)
' ==============================================================================
node "Render.com Cloud Platform\n<<Managed Cloud Web Service>>\n[Linux Containerized Runtime - Node.js 20 LTS]\nEndpoint: https://iata-project-o4z6.onrender.com" as ServerNode #E8F5E9 {

    artifact "central-backend\n<<Backend Web Service Artifact>>\n[NestJS 10 / Node.js 20 LTS]" as BackendArtifact {
        component "API Gateway & Router\n(Swagger / OpenAPI Endpoint: /api/v1)" as ApiRouter
        component "Auth & RBAC Guard\n(Passport-JWT, Bcrypt Validator)" as AuthGuard
        component "AI Gateway & Quota Guard\n(AI Token Counter & Limiter)" as AIGateway
        component "In-Memory Rate Limiter\n(Sliding Window Throttler Storage)" as ThrottlerEngine
        component "Audit Logs Service\n(Token Usage & Audit Trail)" as AuditService
        component "ORM Engine\n(Prisma 5 Client)" as OrmEngine
    }
}

' ==============================================================================
' 4. DATABASE SERVER TIER (DỊCH VỤ CƠ SỞ DỮ LIỆU ĐÁM MÂY - NEON CLOUD)
' ==============================================================================
node "Neon Serverless Postgres\n<<Managed Cloud Database Service>>\n[Lakebase PostgreSQL 16 Architecture]\nMulti-AZ Storage & Auto-scaling" as DbNode #EDE7F6 {
    
    database "aita_central_db\n<<Serverless PostgreSQL 16>>" as PostgresDB {
        artifact "Tables Schema:\n- users\n- ai_quota_configs, ai_quota_logs\n- refresh_tokens" as DbSchema
    }
}

' ==============================================================================
' 5. EXTERNAL CLOUD AI SERVICE TIER (DỊCH VỤ TRÍ TUỆ NHÂN TẠO ĐÁM MÂY)
' ==============================================================================
node "Google Cloud Platform (GCP)\n<<Public Cloud Infrastructure>>\nRegion: us-central1 / asia-southeast1" as CloudAINode #FFFDE7 {
    node "Google AI Foundation Services\n<<Managed Cloud PaaS>>" as AiEnv #FFFFFF {
        component "AI Model API\n<<LLM Inference Endpoint>>\n[generativelanguage.googleapis.com]" as AiApi
    }
}

' ==============================================================================
' CÁC KẾT NỐI MẠNG, GIAO THỨC & CỔNG TRUYỀN THÔNG (NETWORK PROTOCOLS & PORTS)
' ==============================================================================

' Kết nối từ Admin Browser đến Render Cloud Service
AdminNode -- ApiRouter : **HTTPS / TLS 1.3**\n[TCP Port 443]\n(REST API & Web Admin UI)

' Kết nối từ Desktop Client Giảng viên đến Render Cloud Service
SyncClient -- ApiRouter : **HTTPS / TLS 1.3**\n[TCP Port 443]\n(JSON REST API, Bearer JWT Auth)

' Backend kết nối CSDL Neon PostgreSQL qua SSL connection pool
OrmEngine -- PostgresDB : **PostgreSQL Native Protocol over TLS**\n[Port 5432 / Prisma Pooled & Direct URL]

' Backend gọi AI Cloud
AIGateway -- AiApi : **HTTPS / REST & gRPC**\n[TCP Port 443 / TLS 1.3]\n(AI SDK, Secure API Key Header)

' ==============================================================================
' GHI CHÚ KIẾN TRÚC & MẪU THIẾT KẾ (DESIGN PATTERNS SPECIFICATION NOTES)
' ==============================================================================
note bottom of InstructorNode
    <b>ĐẶC TẢ MÁY TRẠM GIẢNG VIÊN (DESKTOP CLIENT):</b>
    • <b>Hệ điều hành:</b> Windows 10/11 x64, vận hành theo mô hình <i>Offline-First</i>.
    • <b>Triển khai 3 Design Patterns:</b>
       - <i>Factory Method:</i> RunnerFactory nhận diện đuôi file (.c, .java, .py) để sinh đúng Runner.
       - <i>Adapter Pattern:</i> CompilerAdapter chuẩn hóa CLI và mã lỗi của GCC, Javac, Python.
       - <i>Strategy Pattern:</i> MatchingContext thực thi 7 thuật toán độc lập kết hợp qua FlexibleMatchingStrategy.
    • <b>Sandbox An Toàn:</b> Subprocess cô lập kết hợp psutil để diệt tiến trình lặp vô hạn (TLE) và tràn RAM (MLE).
end note

note bottom of ServerNode
    <b>ĐẶC TẢ MÁY CHỦ TRUNG TÂM (CENTRAL BACKEND):</b>
    • <b>Nền tảng Cloud PaaS:</b> Triển khai trên Render.com Web Service (hoặc chạy local bằng Node.js 20).
    • <b>Bảo mật & Phân quyền:</b> Render quản lý SSL/TLS 1.3 tự động, NestJS bảo vệ endpoint qua JWT RBAC Guard.
    • <b>Rate Limiting:</b> In-Memory sliding-window rate limiter tích hợp sẵn (không phụ thuộc Redis riêng biệt).
    • <b>AI Gateway Hub:</b> Đọc API Key từ secret biến môi trường; kiểm soát Quota và đếm token tiêu thụ.
end note

note bottom of DbNode
    <b>CƠ SỞ DỮ LIỆU ĐÁM MÂY (NEON POSTGRESQL):</b>
    • <b>Serverless PostgreSQL 16:</b> Tự động scale dung lượng, kết nối bảo mật mã hóa qua TLS 1.3.
    • <b>Connection Pooling:</b> Sử dụng Prisma với cả Pooled URL và Direct URL (cho migrate).
    • <b>Dữ liệu tập trung:</b> Quản lý tài khoản, nhật ký tiêu thụ Token và cấu hình hạn ngạch AI.
end note

@enduml
