@startuml
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam object {
    BackgroundColor #FFFFFF
    BorderColor #1E88E5
    ArrowColor #2E7D32
    FontSize 11
    FontStyle bold
}

title Sơ Đồ Giao Tiếp Tổng Thể Toàn Hệ Thống (System-Wide Communication Diagram) - AITA Ecosystem

' --- 1. Tác Nhân Người Dùng (Human Actors) ---
object "<u>:SystemAdmin</u>\n(Quản trị viên)" as Admin
object "<u>:Instructor</u>\n(Giảng viên)" as Instructor

' --- 2. Phân Hệ Giao Diện Người Dùng (UI Layer) ---
object "<u>:WebAdminDashboard</u>\n(Next.js Web UI)" as WebAdminUI
object "<u>:DesktopAppUI</u>\n(PyQt6 UI Layer)" as DesktopUI

' --- 3. Phân Hệ Xử Lý Lõi Desktop (Desktop Core Engine) ---
object "<u>:DesktopCoreController</u>\n(Động cơ Chấm & Điều khiển)" as DesktopCore
object "<u>:LocalDatabase</u>\n(SQLite Cục bộ Giảng viên)" as LocalDB
object "<u>:SandboxRunner</u>\n(GCC/Javac/Python & psutil)" as Sandbox

' --- 4. Phân Hệ Web Server Backend (NestJS Central Server) ---
object "<u>:WebAPIGateway</u>\n(NestJS API Server)" as WebBackend
object "<u>:AuthRBACService</u>\n(Passport-JWT & RBAC Guards)" as AuthService
object "<u>:CentralDatabase</u>\n(Prisma / PostgreSQL Central DB)" as CentralDB

' --- 5. Phân Hệ Trí Tuệ Nhân Tạo (AI Gateway Hub) ---
object "<u>:AIGatewayHub</u>\n(Quản lý Quota; sử dụng key từ môi trường máy chủ)" as AIHub
object "<u>:AiGatewayProvider</u>\n(AI Cloud)" as AiCloud

' ==============================================================================
' CÁC LUỒNG GIAO TIẾP & THÔNG ĐIỆP TOÀN HỆ THỐNG ĐƯỢC ĐÁNH SỐ THEO PHÂN HỆ
' ==============================================================================

' --- NHÓM 1: Quản trị Hệ thống từ Web Admin Dashboard ---
Admin -- WebAdminUI : 1.1: login(credentials)\n1.2: manageInstructors(accounts)\n1.3: setAiQuota(limits)\n1.4: viewAuditLogs()

WebAdminUI -- WebBackend : 1.5: HTTP POST /auth/login\n1.6: HTTP REST (CRUD users)\n1.7: HTTP POST /admin/ai-quota\n1.8: HTTP GET /admin/reports

WebBackend -- AuthService : 1.9: verifyAdminRole(token)\n1.10: hashPassword(bcrypt)

WebBackend -- CentralDB : 1.11: queryAndPersist(users, quotas)

WebBackend -- AIHub : 1.12: updateQuotaPolicy(dailyTokenLimits)

' --- NHÓM 2: Đăng Nhập & Thiết Lập Từ Desktop App Client ---
Instructor -- DesktopUI : 2.1: login(username, password)\n2.2: scanSubmissionFolder(folderPath)\n2.3: inputTestcases(inputs, outputs)\n2.4: configMatchingFlags(checkboxes)

DesktopUI -- DesktopCore : 2.5: authenticate(credentials)\n2.6: scanFolderAndParseMssv(folderPath)\n2.7: saveTestcases(testcaseList)\n2.8: setMatchingFlags(flagsCombination)

DesktopCore -- WebBackend : 2.9: HTTP POST /api/v1/auth/login (lấy JWT Token)

DesktopCore -- LocalDB : 2.11: cacheSubmissions(students)\n2.12: persistTestcases(testcases)

' --- NHÓM 3: Thực Thi Chấm Bài Tự Động Offline-First (Đa tiến trình) ---
Instructor -- DesktopUI : 3.1: clickStartBatchGrading()

DesktopUI -- DesktopCore : 3.2: startBatchGradingAsync()

DesktopCore -- Sandbox : 3.3: compileCode(gcc / javac)\n3.4: runMainProcess(stdin=Input, limits)\n3.7: measureResource(psutil: RAM, CPU)

Sandbox -- DesktopCore : 3.5: returnActualOutput(stdout)\n3.6: returnExitStatus(AC, WA, TLE, MLE, CE, RE)

DesktopCore -- LocalDB : 3.8: saveBatchResult(studentId, score, verdict, runtimeMs)

DesktopCore -- DesktopUI : 3.9: emitRealtimeProgress(completed, total)\n3.10: displayResultsTable()

' --- NHÓM 4: Trí Tuệ Nhân Tạo Thông Minh & Xuất Bảng Điểm Cục Bộ ---
Instructor -- DesktopUI : 4.1: requestAITestcase(problemStatement)\n4.4: requestAICodeReview(WA_studentId)\n4.7: checkPlagiarism2Stage()\n4.10: exportGradebook("results.csv")

DesktopUI -- DesktopCore : 4.2: triggerAIGenerateTestcases()\n4.5: triggerOnDemandCodeReview()\n4.8: runLocalASTScan()\n4.11: exportToDisk("results.csv")

DesktopCore -- WebBackend : 4.3: HTTP POST /ai/generate-testcases\n4.6: HTTP POST /ai/code-review (On-Demand)\n4.9: HTTP POST /ai/verify-plagiarism (>80% only)

WebBackend -- AIHub : 4.12: validateQuotaAndForward(token, promptJson)

AIHub -- AiCloud : 4.13: generateContent(Multimodal 1.5 Flash)\n4.14: returnStructuredJSON()

AIHub -- WebBackend : 4.15: returnAIFeedbackAndTrackTokens()

WebBackend -- CentralDB : 4.16: saveAILogs(tokenUsage, timestamp)

@enduml
