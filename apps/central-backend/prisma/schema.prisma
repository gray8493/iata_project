generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(120)
  role         String    @default("INSTRUCTOR") @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quotaConfig  AiQuotaConfig?
  quotaLogs    AiQuotaLog[]
  refreshTokens RefreshToken[]

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model AiQuotaConfig {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  dailyTokenLimit Int       @default(50000) @map("daily_token_limit")
  usedTokensToday Int       @default(0) @map("used_tokens_today")
  lastResetDate   DateTime  @default(dbgenerated("CURRENT_DATE")) @map("last_reset_date") @db.Date
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_quota_configs")
}

model AiQuotaLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  featureType      String   @map("feature_type") @db.VarChar(30)
  modelName        String   @default("gemini-3.8-flash") @map("model_name") @db.VarChar(50)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt], map: "idx_ai_quota_logs_user_created")
  @@index([createdAt, featureType], map: "idx_ai_quota_logs_created_feature")
  @@map("ai_quota_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_expires")
  @@map("refresh_tokens")
}
