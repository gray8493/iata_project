NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aita?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/aita?schema=public
REDIS_URL=
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
OPENROUTER_API_KEYS=sk-or-v1-key-account-1,sk-or-v1-key-account-2,sk-or-v1-key-account-3
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Danh sách model dự phòng (phân tách bởi dấu phẩy). Khi model chính bị throttle/lỗi,
# OpenRouter tự nhảy sang các model này. Nên chọn model có vision nếu dùng chấm Web UI.
OPENROUTER_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Desktop Client Auto-Update manifest (served by GET /system/version)
# Ưu tiên: release mới nhất trên GitHub (APP_UPDATE_SOURCE=github) -> fallback các biến bên dưới.
# Nhờ vậy mỗi bản phát hành chỉ cần tạo GitHub Release, không phải sửa env rồi redeploy.
APP_UPDATE_SOURCE=github
APP_UPDATE_GITHUB_REPO=gray8493/iata_project
APP_UPDATE_GITHUB_TTL_SECONDS=300
APP_UPDATE_GITHUB_TIMEOUT_MS=5000
# Chỉ cần khi repo private: fine-grained PAT có quyền Contents = Read-only
GITHUB_TOKEN=

# Fallback khi APP_UPDATE_SOURCE=env / chưa cấu hình repo / gọi GitHub lỗi
APP_LATEST_VERSION=1.0.0
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_UPDATE_MANDATORY=false
APP_UPDATE_ARTIFACT_TYPE=zip
APP_UPDATE_ENTRYPOINT=AITA_Grader_v1.exe
APP_UPDATE_URL_WINDOWS=
APP_UPDATE_SHA256_WINDOWS=
APP_UPDATE_SIZE_WINDOWS=0
APP_UPDATE_NOTES=
APP_UPDATE_PUBLISHED_AT=
