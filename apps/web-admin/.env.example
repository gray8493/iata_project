# Base URL of the Central Backend (NestJS) REST API.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
#
# Local development: copy this file to .env.local
#   cp .env.example .env.local
# Production: set NEXT_PUBLIC_API_URL in the build platform's environment
#   (e.g. Vercel or Render) and trigger a new build/redeploy.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
